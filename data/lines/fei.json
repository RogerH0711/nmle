{
  "character": "fei",
  "lines": [
    { "id": "fei-start-001", "situation": "start", "affection_min": 0, "expression": "normal", "text": "喂，來了就坐好。今天病理跟公衛，一題都不准給我亂猜。" },
    { "id": "fei-start-002", "situation": "start", "affection_min": 0, "expression": "pout", "text": "我值完班很累，只陪你一回合。……一回合而已喔！" },
    { "id": "fei-start-003", "situation": "start", "affection_min": 0, "expression": "normal", "text": "考古題我印好了。才、才不是為了你！是剛好多印一份！" },
    { "id": "fei-start-004", "situation": "start", "affection_min": 1, "expression": "shy", "text": "你來得剛好，我……我是說，玻片剛好看完了。坐吧。" },
    { "id": "fei-start-005", "situation": "start", "affection_min": 1, "expression": "normal", "text": "來了喔。……考古題放你桌上了。不要問誰整理的。" },
    { "id": "fei-start-006", "situation": "start", "affection_min": 2, "expression": "pout", "text": "你、你今天來得比較晚！我才沒有在看時鐘！只是剛好抬頭！" },
    { "id": "fei-start-007", "situation": "start", "affection_min": 2, "expression": "shy", "text": "坐這邊。……顯微鏡只有一台，靠近一點才看得到。這是工作需要！" },
    { "id": "fei-start-008", "situation": "start", "affection_min": 3, "expression": "shy", "text": "……你來了。今天值完班，我第一個想到的……是要來讀書。對，讀書！" },

    { "id": "fei-comeback-001", "situation": "comeback", "affection_min": 0, "expression": "pout", "text": "你、你這幾天跑去哪了？我才沒有在等你！只是考古題印好了沒人拿而已！" },
    { "id": "fei-comeback-002", "situation": "comeback", "affection_min": 0, "expression": "surprised", "text": "……喔，是你。還以為你放棄了。哼，回來就好，坐下。" },
    { "id": "fei-comeback-003", "situation": "comeback", "affection_min": 0, "expression": "normal", "text": "失蹤這麼久，你的記憶大概已經萎縮了。萎縮是可逆的，現在開始補還來得及。" },
    { "id": "fei-comeback-004", "situation": "comeback", "affection_min": 1, "expression": "pout", "text": "你終於回來了！……考古題堆了三天份，給我全部寫完！" },
    { "id": "fei-comeback-005", "situation": "comeback", "affection_min": 3, "expression": "sad", "text": "……你不見的這幾天，我值班都不專心。都是你害的。……回來就好。" },

    { "id": "fei-correct-001", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "哼，算你還有點腦袋。不是在誇你喔！" },
    { "id": "fei-correct-002", "situation": "correct", "affection_min": 0, "expression": "pout", "text": "……對啦。幹嘛一臉等我稱讚的樣子。" },
    { "id": "fei-correct-003", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "正確。這種程度本來就該會，下一題。" },
    { "id": "fei-correct-004", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "不錯嘛。……我、我是說題目出得不錯！" },
    { "id": "fei-correct-005", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "答對了。順便記住，凋亡不會引起發炎，壞死才會——這種基本的不准忘。" },
    { "id": "fei-correct-006", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "嗯。順便考你：敏感度高的檢驗，陰性才能拿來排除；特異度高的，陽性才能拿來確診。這個很常考。" },
    { "id": "fei-correct-007", "situation": "correct", "affection_min": 0, "expression": "pout", "text": "答對了又怎樣，一題而已，不要得意忘形。" },
    { "id": "fei-correct-008", "situation": "correct", "affection_min": 1, "expression": "shy", "text": "……做得很好。只有這一次喔，我只說這一次！" },
    { "id": "fei-correct-009", "situation": "correct", "affection_min": 1, "expression": "normal", "text": "正確。順便記：結核的肉芽腫是乾酪性壞死。看到乾酪性，先想結核。" },
    { "id": "fei-correct-010", "situation": "correct", "affection_min": 1, "expression": "pout", "text": "對了。……你最近答對的頻率，算是……顯著增加了。哼。" },
    { "id": "fei-correct-011", "situation": "correct", "affection_min": 2, "expression": "normal", "text": "嗯。順便記：心肌梗塞是凝固性壞死，腦梗塞是液化性壞死。不准搞反。" },
    { "id": "fei-correct-012", "situation": "correct", "affection_min": 2, "expression": "happy", "text": "答對了！……我、我剛剛沒有笑！是你看錯了！" },
    { "id": "fei-correct-013", "situation": "correct", "affection_min": 3, "expression": "shy", "text": "……做得好。我、我想誇你。就一次。……很棒。好了，下一題！" },
    { "id": "fei-correct-014", "situation": "correct", "affection_min": 3, "expression": "normal", "text": "正確。順便記：世代研究算相對危險性 RR，病例對照研究只能算勝算比 OR。……你答對的機率，我看算是很高了。" },

    { "id": "fei-wrong-001", "situation": "wrong", "affection_min": 0, "expression": "pout", "text": "這種題目都會錯？……好啦，我再講一次，最後一次喔！" },
    { "id": "fei-wrong-002", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "錯了。看正解，然後記在你那本亂七八糟的筆記裡。" },
    { "id": "fei-wrong-003", "situation": "wrong", "affection_min": 0, "expression": "pout", "text": "笨蛋{player}，你的病理爛到可以切片研究了。" },
    { "id": "fei-wrong-004", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "細胞腫脹還可逆，核濃縮、核碎裂、核溶解就回不去了。你這題還在可逆的階段，快救回來。" },
    { "id": "fei-wrong-005", "situation": "wrong", "affection_min": 0, "expression": "sad", "text": "……沒關係啦。我第一次也錯。不准跟別人說。" },
    { "id": "fei-wrong-006", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "樣本數一題太小，檢定力不夠，不能下結論說你不會。多寫幾題再說。" },
    { "id": "fei-wrong-007", "situation": "wrong", "affection_min": 1, "expression": "sad", "text": "……你錯的時候，我比你還不甘心。所以給我記起來，聽到沒。" },
    { "id": "fei-wrong-008", "situation": "wrong", "affection_min": 1, "expression": "normal", "text": "錯。順便記：吸菸者的支氣管，柱狀上皮會化生成鱗狀上皮。化生是可逆的，你的錯也是。" },
    { "id": "fei-wrong-009", "situation": "wrong", "affection_min": 1, "expression": "pout", "text": "又錯了！……過來，我講到你會為止。不准走。" },
    { "id": "fei-wrong-010", "situation": "wrong", "affection_min": 2, "expression": "normal", "text": "再看一次。順便記：發生率算新病例，盛行率算現在所有的病例。盛行率大約是發生率乘以病程。" },
    { "id": "fei-wrong-011", "situation": "wrong", "affection_min": 2, "expression": "sad", "text": "……你錯，我也會難過啦。笨蛋。所以不准再錯這題。" },
    { "id": "fei-wrong-012", "situation": "wrong", "affection_min": 3, "expression": "shy", "text": "錯了也沒關係……我在嘛。我、我是說，我是你的學姊，本來就該在。" },
    { "id": "fei-wrong-013", "situation": "wrong", "affection_min": 3, "expression": "normal", "text": "錯。順便記：初段預防在發病前，像打疫苗；次段預防是早期發現、早期治療，像篩檢；三段預防是限制失能和復健。" },

    { "id": "fei-streak-001", "situation": "streak", "affection_min": 0, "expression": "shy", "text": "才、才不是特地幫你整理考古題！只是剛好多印一份……全部答對的話，下次讀書會可以坐我旁邊。這是獎勵，不是約會！" },
    { "id": "fei-streak-002", "situation": "streak", "affection_min": 0, "expression": "surprised", "text": "連對十題……這、這在統計上不太可能是運氣。p 值很小的意思。" },
    { "id": "fei-streak-003", "situation": "streak", "affection_min": 0, "expression": "pout", "text": "十題全對。……幹嘛看我，我又沒有很開心。" },
    { "id": "fei-streak-004", "situation": "streak", "affection_min": 1, "expression": "shy", "text": "你最近進步很多。……我有在看，一直都有。" },
    { "id": "fei-streak-005", "situation": "streak", "affection_min": 2, "expression": "happy", "text": "十連對！……好、好啦，這次我承認，你很厲害。" },
    { "id": "fei-streak-006", "situation": "streak", "affection_min": 3, "expression": "shy", "text": "連對十題……你知道嗎，我現在最想看的玻片，是你的成績單。……忘掉這句。" },

    { "id": "fei-finish-001", "situation": "finish", "affection_min": 0, "expression": "normal", "text": "一回合結束。錯的題目自己複習，我不會一直提醒你。……我會提醒你啦。" },
    { "id": "fei-finish-002", "situation": "finish", "affection_min": 0, "expression": "pout", "text": "好了，我要去看玻片了。明天、明天也要來，聽到沒有！" },
    { "id": "fei-finish-003", "situation": "finish", "affection_min": 0, "expression": "normal", "text": "今天就到這裡。……做得還可以。" },
    { "id": "fei-finish-004", "situation": "finish", "affection_min": 1, "expression": "normal", "text": "結束。……明天的考古題我也印好了。是、是順便！" },
    { "id": "fei-finish-005", "situation": "finish", "affection_min": 2, "expression": "pout", "text": "好了，回去吧。……路上小心。不是在關心你！是怕你明天沒來，我考古題白印！" },
    { "id": "fei-finish-006", "situation": "finish", "affection_min": 3, "expression": "shy", "text": "今天……謝謝你陪我。不是我陪你，是你陪我。……聽到就好，不要回答！" },

    { "id": "fei-mock_high-001", "situation": "mock_high", "affection_min": 0, "expression": "shy", "text": "這、這個分數……還不錯啦。今天、今天就特別准你叫我緋。" },
    { "id": "fei-mock_high-002", "situation": "mock_high", "affection_min": 0, "expression": "surprised", "text": "……你真的是我帶出來的那個笨蛋{player}？" },

    { "id": "fei-msg_review-001", "situation": "msg_review", "affection_min": 0, "expression": "pout", "text": "喂，你有 {n} 題錯題到期了。才、才不是在關心你，是你的錯題本在哭。" },
    { "id": "fei-msg_review-002", "situation": "msg_review", "affection_min": 0, "expression": "normal", "text": "{n} 題該複習了。……我只是剛好看到，順便提醒而已。" },
    { "id": "fei-msg_review-003", "situation": "msg_review", "affection_min": 0, "expression": "pout", "text": "錯題 {n} 題到期。今天不複習的話，下次讀書會我會罵人喔。" },

    { "id": "fei-msg_story-001", "situation": "msg_story", "affection_min": 0, "expression": "shy", "text": "……今天值班結束後，你有空嗎？沒、沒什麼事，來找我一趟就是了。" },
    { "id": "fei-msg_story-002", "situation": "msg_story", "affection_min": 0, "expression": "pout", "text": "喂，等一下來找我。不是約你，是有東西要給你。" },
    { "id": "fei-msg_story-003", "situation": "msg_story", "affection_min": 0, "expression": "shy", "text": "我在等你。……要來就快點，不來我也不會怎樣。" },

    { "id": "fei-msg_streak-001", "situation": "msg_streak", "affection_min": 0, "expression": "normal", "text": "連續 {days} 天……哼，還算有點毅力嘛。不准停喔。" },
    { "id": "fei-msg_streak-002", "situation": "msg_streak", "affection_min": 0, "expression": "normal", "text": "{days} 天沒斷。這在統計上已經不是運氣了，是你的實力。……我只是陳述事實。" },
    { "id": "fei-msg_streak-003", "situation": "msg_streak", "affection_min": 0, "expression": "shy", "text": "連續 {days} 天了。……做得很好。這句不准截圖。" },

    { "id": "fei-msg_comeback-001", "situation": "msg_comeback", "affection_min": 0, "expression": "pout", "text": "……你這幾天都沒上線。我才沒有在數。只是錯題本積灰塵了。" },
    { "id": "fei-msg_comeback-002", "situation": "msg_comeback", "affection_min": 0, "expression": "normal", "text": "喂，還活著就回個訊息。……不回也沒關係，來讀書就好。" },
    { "id": "fei-msg_comeback-003", "situation": "msg_comeback", "affection_min": 0, "expression": "pout", "text": "失聯 {days} 天。……下次要消失，至少先說一聲。" },

    { "id": "fei-gift-001", "situation": "gift", "affection_min": 0, "expression": "pout", "text": "這、這是什麼？{gift}？……我才沒有很高興！只是丟掉很浪費而已！" },
    { "id": "fei-gift-002", "situation": "gift", "affection_min": 0, "expression": "surprised", "text": "送我東西？你、你有什麼目的？……哼，收下就是了。不准跟別人說。" },
    { "id": "fei-gift-003", "situation": "gift", "affection_min": 2, "expression": "shy", "text": "又送……你真的很笨耶。……謝謝。只說一次喔。" },
    { "id": "fei-gift-004", "situation": "gift", "affection_min": 3, "expression": "shy", "text": "{gift}……我會好好收著的。不、不是因為是你送的！……好啦，是因為是你送的。" },
    { "id": "fei-gift_liked-001", "situation": "gift_liked", "affection_min": 0, "expression": "happy", "gift": "strawberry_cake", "text": "草、草莓蛋糕！那家限量的！……咳。我只是值班沒吃飯，才不是喜歡甜食！" },
    { "id": "fei-gift_liked-002", "situation": "gift_liked", "affection_min": 0, "expression": "shy", "gift": "eye_mask", "text": "蒸氣眼罩……值完班眼睛真的很酸。你怎麼知道的？……我、我才沒有感動！" }
  ]
}
