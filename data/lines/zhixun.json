{
  "character": "zhixun",
  "lines": [
    { "id": "zhixun-start-001", "situation": "start", "affection_min": 0, "expression": "happy", "text": "小{player}來了呀。今天姊姊陪你讀藥理，乖，慢慢來。" },
    { "id": "zhixun-start-002", "situation": "start", "affection_min": 0, "expression": "normal", "text": "先坐好。藥理不用急著背，先懂機轉，劑量才不會下錯。" },
    { "id": "zhixun-start-003", "situation": "start", "affection_min": 0, "expression": "happy", "text": "剛值完大夜班……眼睛有點睜不開。小{player}，等一下姊姊要是睡著了，記得叫我。" },
    { "id": "zhixun-start-004", "situation": "start", "affection_min": 1, "expression": "shy", "text": "欸，小{player}，姊姊的識別證有沒有掛反？……剛剛同事一直在笑。" },
    { "id": "zhixun-start-005", "situation": "start", "affection_min": 1, "expression": "happy", "text": "小{player}，今天我帶了點心。先吃一口，血糖夠了再開始。" },
    { "id": "zhixun-start-006", "situation": "start", "affection_min": 2, "expression": "normal", "text": "來，坐這裡。你今天好像沒什麼精神，有好好吃飯嗎？" },
    { "id": "zhixun-start-007", "situation": "start", "affection_min": 2, "expression": "happy", "text": "今天下班特別早。……嗯，是我自己跟同事換的班。為了誰呢？你猜。" },
    { "id": "zhixun-start-008", "situation": "start", "affection_min": 3, "expression": "shy", "text": "今天的我，不太像姊姊呢……有點緊張。是因為你喔。", "rare": true },

    { "id": "zhixun-comeback-001", "situation": "comeback", "affection_min": 0, "expression": "sad", "text": "好久不見了呢。最近很忙嗎？沒關係，今天慢慢來。" },
    { "id": "zhixun-comeback-002", "situation": "comeback", "affection_min": 0, "expression": "normal", "text": "幾天沒讀，忘了一些很正常。我們從上次停下來的地方開始。" },
    { "id": "zhixun-comeback-003", "situation": "comeback", "affection_min": 0, "expression": "surprised", "text": "哎呀，小{player}？我還以為你對姊姊產生耐受性了呢。", "affection_max": 1 },
    { "id": "zhixun-comeback-004", "situation": "comeback", "affection_min": 1, "expression": "sad", "text": "回來了呀。這幾天值班的時候，我一直在想你有沒有好好讀書。" },
    { "id": "zhixun-comeback-005", "situation": "comeback", "affection_min": 3, "expression": "sad", "text": "……好久不見。姊姊有點生氣，也有點擔心。先抱一下，再讀書。" },

    { "id": "zhixun-correct-001", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "好棒好棒，小{player}今天的吸收率很好呢。", "rare": true },
    { "id": "zhixun-correct-002", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "正確。我就知道你會。" },
    { "id": "zhixun-correct-003", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "答對了。嗯，這題很漂亮。" },
    { "id": "zhixun-correct-004", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "對了。rifampin 是很強的 CYP 酵素誘導劑，很多一起吃的藥會被代謝得比較快、效果變差，像口服避孕藥、warfarin。", "keywords": ["rifampin", "rifampicin"] },
    { "id": "zhixun-correct-005", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "很好。warfarin 需要逆轉的時候用維生素 K，嚴重出血還要補凝血因子。", "keywords": ["warfarin"] },
    { "id": "zhixun-correct-006", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "答對了。乙醯胺酚（acetaminophen）過量，解毒劑是 N-acetylcysteine。", "keywords": ["acetaminophen", "乙醯胺酚", "paracetamol", "acetylcysteine"] },
    { "id": "zhixun-correct-007", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "正確。小{player}認真的時候，姊姊會忍不住多看兩眼呢。" },
    { "id": "zhixun-correct-008", "situation": "correct", "affection_min": 1, "expression": "shy", "text": "做得真好。……嗯，真的。" },
    { "id": "zhixun-correct-009", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "答對了。β 阻斷劑過量造成低血壓、心跳過慢的時候，可以用 glucagon，它不用經過 β 受體就能讓心跳變快。", "keywords": [["propranolol", "過量"], ["propranolol", "overdose"], ["β", "過量"], ["glucagon", "β"], ["glucagon", "propranolol"]] },
    { "id": "zhixun-correct-010", "situation": "correct", "affection_min": 1, "expression": "happy", "text": "好棒。你最近進步好多，我都看在眼裡喔。" },
    { "id": "zhixun-correct-011", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "正確。aminoglycoside 類抗生素，副作用要記耳毒性跟腎毒性。", "keywords": ["aminoglycoside", "胺基醣苷", "gentamicin", "amikacin", "streptomycin", "tobramycin"] },
    { "id": "zhixun-correct-012", "situation": "correct", "affection_min": 2, "expression": "happy", "text": "答對了，乖。……頭過來，這次姊姊不只摸一下喔。" },
    { "id": "zhixun-correct-013", "situation": "correct", "affection_min": 3, "expression": "shy", "text": "……好厲害。最近看著你寫題目，姊姊常常忘記自己要說什麼。", "rare": true },
    { "id": "zhixun-correct-014", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "對了。甲醇中毒用 fomepizole，它抑制醇去氫酶，讓甲醇不會被代謝成有毒的甲醛和甲酸。", "keywords": ["甲醇", "methanol", "fomepizole", "乙二醇", "ethylene glycol"] },
    { "id": "zhixun-correct-015", "situation": "correct", "affection_min": 0, "expression": "normal", "keywords": ["heparin", "肝素", "protamine", "andexanet", "rivaroxaban", "apixaban"], "text": "正確。普通肝素可以用 protamine 逆轉；rivaroxaban、apixaban 這類 Xa 因子抑制劑，則是用 andexanet alfa。" },

    { "id": "zhixun-wrong-001", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "錯了也沒關係，先看一下正解，再試一次。" },
    { "id": "zhixun-wrong-002", "situation": "wrong", "affection_min": 0, "expression": "happy", "text": "哎呀，答錯了。是不是姊姊坐太近，害你分心了？" },
    { "id": "zhixun-wrong-003", "situation": "wrong", "affection_min": 0, "expression": "sad", "text": "這題有點可惜呢。沒關係，複習的時候我們再一起看。" },
    { "id": "zhixun-wrong-004", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "沒關係。口服的藥要先經過肝臟的首渡效應，生體可用率常常比較低；靜脈注射直接進到血液，生體可用率是 100%。", "keywords": ["生體可用率", "bioavailability", "首渡", "first-pass", "first pass"] },
    { "id": "zhixun-wrong-005", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "錯了喔。有機磷中毒用 atropine 加 pralidoxime，臨床真的會用到。", "keywords": ["有機磷", "organophosphate", "pralidoxime", "2-PAM"] },
    { "id": "zhixun-wrong-006", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "再看一次正解吧。ACE 抑制劑的乾咳，跟緩激肽（bradykinin）累積有關。", "keywords": ["ACE 抑制劑", "ACE抑制劑", "ACE inhibitor", "captopril", "enalapril", "lisinopril", "緩激肽", "bradykinin"] },
    { "id": "zhixun-wrong-007", "situation": "wrong", "affection_min": 1, "expression": "sad", "text": "……看你皺眉，姊姊也跟著難過。這題我們一起把它記熟，好嗎？" },
    { "id": "zhixun-wrong-008", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "沒關係。digoxin 抑制 Na⁺/K⁺-ATPase，病人血鉀低的時候，毒性會變強。", "keywords": ["digoxin", "毛地黃", "digitalis"] },
    { "id": "zhixun-wrong-009", "situation": "wrong", "affection_min": 1, "expression": "sad", "text": "答錯了呢……別灰心，乖，姊姊在這裡。" },
    { "id": "zhixun-wrong-010", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "再看一次正解吧。鴉片類藥物用久了，止痛和呼吸抑制都會產生耐受性，但縮瞳和便秘幾乎不會。", "keywords": [["鴉片", "耐受"], ["opioid", "tolerance"], ["嗎啡", "耐受"], ["morphine", "tolerance"], "縮瞳", "miosis"] },
    { "id": "zhixun-wrong-011", "situation": "wrong", "affection_min": 2, "expression": "happy", "text": "錯了也很可愛呢。……不行，這樣說好像在鼓勵你答錯。下一題要對喔。" },
    { "id": "zhixun-wrong-012", "situation": "wrong", "affection_min": 3, "expression": "shy", "text": "沒關係，慢慢來。姊姊有的是時間陪你。", "rare": true },
    { "id": "zhixun-wrong-013", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "錯了喔。statin 抑制 HMG-CoA 還原酶，要注意肌肉痠痛，嚴重的話會橫紋肌溶解。", "keywords": ["statin", "HMG-CoA", "atorvastatin", "simvastatin"] },

    { "id": "zhixun-streak-001", "situation": "streak", "affection_min": 0, "expression": "happy", "text": "十題全對，獎勵你一下——頭過來，姊姊摸摸。" },
    { "id": "zhixun-streak-002", "situation": "streak", "affection_min": 0, "expression": "surprised", "text": "連對十題？小{player}，你今天狀態很好耶。" },
    { "id": "zhixun-streak-003", "situation": "streak", "affection_min": 0, "expression": "happy", "text": "好厲害。今天要不要多寫一回合？我陪你。" },
    { "id": "zhixun-streak-004", "situation": "streak", "affection_min": 1, "expression": "shy", "text": "一直答對的小{player}，表情好認真……姊姊都看呆了。" },
    { "id": "zhixun-streak-005", "situation": "streak", "affection_min": 2, "expression": "happy", "text": "十題全對。等你考過一階，姊姊要拿這個去跟其他學姊炫耀。" },
    { "id": "zhixun-streak-006", "situation": "streak", "affection_min": 3, "expression": "shy", "text": "又連對了……小{player}，你知道姊姊現在有多驕傲嗎。" },

    { "id": "zhixun-finish-001", "situation": "finish", "affection_min": 0, "expression": "happy", "text": "這回合到這裡囉。錯的那幾題不用急，複習的時候姊姊陪你看。" },
    { "id": "zhixun-finish-002", "situation": "finish", "affection_min": 0, "expression": "normal", "text": "辛苦了。回去早點休息，睡不夠的時候，讀的東西很難記住。" },
    { "id": "zhixun-finish-003", "situation": "finish", "affection_min": 0, "expression": "happy", "text": "這回合結束。下次也要來找姊姊喔，約好了。" },
    { "id": "zhixun-finish-004", "situation": "finish", "affection_min": 1, "expression": "happy", "text": "今天也辛苦了。明天姊姊也在這裡等你。" },
    { "id": "zhixun-finish-005", "situation": "finish", "affection_min": 2, "expression": "normal", "text": "辛苦了。姊姊送你到門口吧，晚上風大，外套借你。", "night": true },
    { "id": "zhixun-finish-006", "situation": "finish", "affection_min": 3, "expression": "shy", "text": "結束了……其實姊姊不太想結束。", "rare": true },

    { "id": "zhixun-mock_high-001", "situation": "mock_high", "affection_min": 0, "expression": "happy", "text": "考這個分數，姊姊請你喝咖啡。……要約在哪裡，你決定。" },
    { "id": "zhixun-mock_high-002", "situation": "mock_high", "affection_min": 0, "expression": "surprised", "text": "這個分數……小{player}，姊姊是不是太小看你了？" },

    { "id": "zhixun-msg_review-001", "situation": "msg_review", "affection_min": 0, "expression": "happy", "text": "小{player}，今天有 {n} 題錯題到期了喔。藥要按時吃，書也要按時讀喔。" },
    { "id": "zhixun-msg_review-002", "situation": "msg_review", "affection_min": 0, "expression": "normal", "text": "錯題 {n} 題到期了呢。今天寫完再睡喔，慢慢來。" },
    { "id": "zhixun-msg_review-003", "situation": "msg_review", "affection_min": 0, "expression": "happy", "text": "提醒你一下：{n} 題該複習了。寫完傳訊息跟姊姊說。" },

    { "id": "zhixun-msg_story-001", "situation": "msg_story", "affection_min": 0, "expression": "normal", "text": "今天下班後，來找姊姊好嗎？有點話想跟你說。" },
    { "id": "zhixun-msg_story-002", "situation": "msg_story", "affection_min": 0, "expression": "shy", "text": "小{player}，姊姊在等你喔。不是什麼大事，只是想見你。" },
    { "id": "zhixun-msg_story-003", "situation": "msg_story", "affection_min": 0, "expression": "happy", "text": "下班了。陪姊姊聊一下好嗎？" },

    { "id": "zhixun-msg_streak-001", "situation": "msg_streak", "affection_min": 0, "expression": "happy", "text": "連續 {days} 天了呢，好棒好棒。下次見面摸摸頭。" },
    { "id": "zhixun-msg_streak-002", "situation": "msg_streak", "affection_min": 0, "expression": "happy", "text": "{days} 天都沒有中斷呢。我很驕傲喔。" },
    { "id": "zhixun-msg_streak-003", "situation": "msg_streak", "affection_min": 0, "expression": "normal", "text": "連續 {days} 天，規律得剛剛好。記得也要好好休息喔。" },

    { "id": "zhixun-msg_comeback-001", "situation": "msg_comeback", "affection_min": 0, "expression": "sad", "text": "小{player}，好幾天沒見了呢。是不是太累了？休息夠了再回來就好，姊姊等你。" },
    { "id": "zhixun-msg_comeback-002", "situation": "msg_comeback", "affection_min": 0, "expression": "sad", "text": "{days} 天沒見了……姊姊有點擔心。今天能來一下嗎？" },
    { "id": "zhixun-msg_comeback-003", "situation": "msg_comeback", "affection_min": 0, "expression": "shy", "text": "最近都沒看到你……只是想問你好不好。" },

    { "id": "zhixun-gift-001", "situation": "gift", "affection_min": 0, "expression": "happy", "text": "哎呀，{gift}？小{player}送姊姊東西呀。我收下了，謝謝你。" },
    { "id": "zhixun-gift-002", "situation": "gift", "affection_min": 0, "expression": "normal", "text": "謝謝。不過小{player}，錢要留著自己用喔。……這次就算了，姊姊很開心。", "affection_max": 1 },
    { "id": "zhixun-gift-003", "situation": "gift", "affection_min": 2, "expression": "shy", "text": "又收到你的禮物了……我今天一整天心情都會很好。" },
    { "id": "zhixun-gift-004", "situation": "gift", "affection_min": 3, "expression": "shy", "text": "又送我東西……小{player}，姊姊會被你寵壞的。" },
    { "id": "zhixun-gift_liked-001", "situation": "gift_liked", "affection_min": 0, "expression": "happy", "gift": "chamomile", "text": "洋甘菊茶！不含咖啡因，值完大夜班喝剛好。……你記得姊姊值夜班呀。" },
    { "id": "zhixun-gift_liked-002", "situation": "gift_liked", "affection_min": 0, "expression": "shy", "gift": "hand_cream", "text": "護手霜……藥局一天要洗好多次手，手都乾裂了。你連這個都注意到了呢。" },
    { "id": "zhixun-outfit-001", "situation": "outfit", "affection_min": 1, "expression": "happy", "outfit": "zhixun_summer", "text": "草帽和長裙？小{player}想看姊姊休假的樣子呀。……那下次放假，要陪姊姊出去走走喔。" },
    { "id": "zhixun-outfit-002", "situation": "outfit", "affection_min": 2, "expression": "shy", "outfit": "zhixun_winter", "text": "圍巾好暖……值完大夜班走出醫院，清晨的風最冷了。以後每天早上，姊姊都會想到你喔。" }
  ]
}
