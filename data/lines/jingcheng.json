{
  "character": "jingcheng",
  "lines": [
    { "id": "jingcheng-start-001", "situation": "start", "affection_min": 0, "expression": "normal", "text": "來了。今天是解剖、胚胎、組織。先把筆記翻開。" },
    { "id": "jingcheng-start-002", "situation": "start", "affection_min": 0, "expression": "normal", "text": "坐。結構要一層一層記，不要跳。" },
    { "id": "jingcheng-start-003", "situation": "start", "affection_min": 0, "expression": "normal", "text": "上次的筆記帶了嗎。好，今天從那裡接著。" },
    { "id": "jingcheng-start-004", "situation": "start", "affection_min": 1, "expression": "shy", "text": "……我泡了茶。兩杯。你要的話，自己拿。" },
    { "id": "jingcheng-start-005", "situation": "start", "affection_min": 1, "expression": "normal", "text": "你的位子，我放了圖譜。翻到上次那頁了。" },
    { "id": "jingcheng-start-006", "situation": "start", "affection_min": 2, "expression": "normal", "text": "來了。今天比較冷，你穿這樣不夠。" },
    { "id": "jingcheng-start-007", "situation": "start", "affection_min": 2, "expression": "normal", "text": "坐近一點。圖太小，你看不清楚。" },
    { "id": "jingcheng-start-008", "situation": "start", "affection_min": 3, "expression": "shy", "text": "……{player}。我今天，有一點想見你。只有一點。", "rare": true },

    { "id": "jingcheng-comeback-001", "situation": "comeback", "affection_min": 0, "expression": "sad", "text": "好幾天沒來。……生病了嗎。" },
    { "id": "jingcheng-comeback-002", "situation": "comeback", "affection_min": 0, "expression": "normal", "text": "你回來了。忘掉的部分，從頭再一次。" },
    { "id": "jingcheng-comeback-003", "situation": "comeback", "affection_min": 0, "expression": "surprised", "text": "{player}？……我以為你不會再來了。坐吧。", "affection_max": 1 },
    { "id": "jingcheng-comeback-004", "situation": "comeback", "affection_min": 1, "expression": "sad", "text": "……你不在的這幾天，我多畫了好幾張圖。沒有人看。" },
    { "id": "jingcheng-comeback-005", "situation": "comeback", "affection_min": 3, "expression": "sad", "text": "……我很擔心。下次要消失，先跟我說。拜託。" },

    { "id": "jingcheng-correct-001", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "正確。位置記住了，就不要忘。" },
    { "id": "jingcheng-correct-002", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "對。下一題。" },
    { "id": "jingcheng-correct-003", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "嗯。答案對，過程也要對。" },
    { "id": "jingcheng-correct-004", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "正確。臂神經叢來自 C5 到 T1，神經根、神經幹、分部、神經索、分支。順序也要會。", "keywords": ["臂神經叢", "brachial plexus"] },
    { "id": "jingcheng-correct-005", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "對。腕隧道裡走的是正中神經，尺神經不走那裡。很多人會搞混。", "keywords": ["腕隧道", "carpal tunnel", "正中神經", "median nerve"] },
    { "id": "jingcheng-correct-006", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "正確。三胚層在第三週形成，也就是原腸胚形成的時候。時間點也要記。", "keywords": ["三胚層", "原腸", "gastrulation", "germ layer"] },
    { "id": "jingcheng-correct-007", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "對。膀胱是移形上皮，撐開的時候會變薄。", "keywords": ["移形上皮", "transitional epithelium", "urothelium", "泌尿上皮"] },
    { "id": "jingcheng-correct-008", "situation": "correct", "affection_min": 1, "expression": "shy", "text": "……做得很好。這句話，我不常說。" },
    { "id": "jingcheng-correct-009", "situation": "correct", "affection_min": 1, "expression": "normal", "text": "正確。你的筆記，現在整齊多了。" },
    { "id": "jingcheng-correct-010", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "對。旋轉肌袖是棘上肌、棘下肌、小圓肌、肩胛下肌。大圓肌不是。", "keywords": ["旋轉肌袖", "rotator cuff", "棘上肌", "supraspinatus"] },
    { "id": "jingcheng-correct-011", "situation": "correct", "affection_min": 2, "expression": "happy", "text": "對。你最近，不會再卡在同一個地方了。" },
    { "id": "jingcheng-correct-012", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "正確。神經管在第四週閉合，前神經孔大約第 25 天，後神經孔大約第 28 天。", "keywords": ["神經管", "neural tube", "神經孔", "neuropore"] },
    { "id": "jingcheng-correct-013", "situation": "correct", "affection_min": 3, "expression": "shy", "text": "……對。我想摸摸你的頭。……可以嗎。不行就算了。", "rare": true },
    { "id": "jingcheng-correct-014", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "正確。小腸腺窩底部的潘氏細胞，會分泌溶菌酶。", "keywords": ["潘氏細胞", "Paneth", "溶菌酶", "lysozyme"] },

    { "id": "jingcheng-wrong-001", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "錯了。沒關係，再一次。這次我在旁邊看著你寫——不要一直看我，看題目。" },
    { "id": "jingcheng-wrong-002", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "再一次。" },
    { "id": "jingcheng-wrong-003", "situation": "wrong", "affection_min": 0, "expression": "sad", "text": "這種地方，很多人會錯。我當年也是。" },
    { "id": "jingcheng-wrong-004", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "錯了。左邊的喉返神經繞過主動脈弓，右邊的繞過鎖骨下動脈。左右不一樣，要記。", "keywords": ["喉返神經", "recurrent laryngeal"] },
    { "id": "jingcheng-wrong-005", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "再看一次正解。食道上三分之一是骨骼肌，下三分之一是平滑肌，中間混合。", "keywords": ["外肌層", "muscularis externa"] },
    { "id": "jingcheng-wrong-006", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "錯了。咽弓要和神經一起背。第一咽弓是三叉神經，第二咽弓是顏面神經。", "keywords": ["咽弓", "鰓弓", "pharyngeal arch", "branchial arch"] },
    { "id": "jingcheng-wrong-007", "situation": "wrong", "affection_min": 1, "expression": "sad", "text": "……你錯的題目，我都畫成圖了。下次拿給你。" },
    { "id": "jingcheng-wrong-008", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "錯了。三角肌是腋神經支配。肱骨外科頸骨折，最容易傷到它。", "keywords": ["腋神經", "axillary nerve", "三角肌", "deltoid", "外科頸", "surgical neck"] },
    { "id": "jingcheng-wrong-009", "situation": "wrong", "affection_min": 1, "expression": "sad", "text": "這裡我畫給你看。筆給你，跟著描一次。" },
    { "id": "jingcheng-wrong-010", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "再一次。第一型肺泡細胞負責氣體交換，第二型分泌表面張力素。不要反過來。", "keywords": ["肺泡細胞", "pneumocyte", "表面張力素", "surfactant"] },
    { "id": "jingcheng-wrong-011", "situation": "wrong", "affection_min": 2, "expression": "sad", "text": "錯了。……不用道歉。你在我面前，可以錯。" },
    { "id": "jingcheng-wrong-012", "situation": "wrong", "affection_min": 3, "expression": "shy", "text": "錯了也沒關係。我會一直在旁邊。……一直。", "rare": true },
    { "id": "jingcheng-wrong-013", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "錯了。門脈三合體是肝動脈、門靜脈的分支，加上膽管。三個一起記。", "keywords": ["門脈三合體", "portal triad", "肝小葉", "hepatic lobule"] },

    { "id": "jingcheng-streak-001", "situation": "streak", "affection_min": 0, "expression": "happy", "text": "十題全對。今天的思路很清楚。" },
    { "id": "jingcheng-streak-002", "situation": "streak", "affection_min": 0, "expression": "surprised", "text": "……連對十題。我沒有很驚訝。只是筆掉了而已。" },
    { "id": "jingcheng-streak-003", "situation": "streak", "affection_min": 0, "expression": "normal", "text": "一直答對。不要停，再一次。" },
    { "id": "jingcheng-streak-004", "situation": "streak", "affection_min": 1, "expression": "normal", "text": "十題。你最近有在自己複習吧。看得出來。" },
    { "id": "jingcheng-streak-005", "situation": "streak", "affection_min": 2, "expression": "happy", "text": "十題全對。……我把這一頁筆記折起來了。紀念用。" },
    { "id": "jingcheng-streak-006", "situation": "streak", "affection_min": 3, "expression": "shy", "text": "……連對十題。{player}，你知道你專心的時候，我都在看你嗎。……現在知道了。" },

    { "id": "jingcheng-finish-001", "situation": "finish", "affection_min": 0, "expression": "normal", "text": "一回合結束。錯的題目，明天再一次。" },
    { "id": "jingcheng-finish-002", "situation": "finish", "affection_min": 0, "expression": "happy", "text": "今天可以了。回去早點睡，記憶要靠睡眠鞏固。", "night": true },
    { "id": "jingcheng-finish-003", "situation": "finish", "affection_min": 0, "expression": "normal", "text": "結束。我還要留下來整理筆記。你先走。", "affection_max": 1 },
    { "id": "jingcheng-finish-004", "situation": "finish", "affection_min": 1, "expression": "normal", "text": "結束。今天的錯題我抄一份，明天對答案。" },
    { "id": "jingcheng-finish-005", "situation": "finish", "affection_min": 2, "expression": "shy", "text": "……要走了嗎。嗯。我送你到門口。" },
    { "id": "jingcheng-finish-006", "situation": "finish", "affection_min": 3, "expression": "shy", "text": "今天也結束了。……明天，我還想看到你。", "rare": true },

    { "id": "jingcheng-mock_high-001", "situation": "mock_high", "affection_min": 0, "expression": "happy", "text": "解剖這部分，你已經比我當年好了。……不准驕傲。" },
    { "id": "jingcheng-mock_high-002", "situation": "mock_high", "affection_min": 0, "expression": "surprised", "text": "……這個分數。我、我去倒杯水。……不要跟過來。" },

    { "id": "jingcheng-msg_review-001", "situation": "msg_review", "affection_min": 0, "expression": "normal", "text": "錯題 {n} 題，今天到期。再一次。" },
    { "id": "jingcheng-msg_review-002", "situation": "msg_review", "affection_min": 0, "expression": "normal", "text": "{n} 題該複習了。我在圖書館。" },
    { "id": "jingcheng-msg_review-003", "situation": "msg_review", "affection_min": 0, "expression": "normal", "text": "今天有 {n} 題要複習。位子幫你留了。" },

    { "id": "jingcheng-msg_story-001", "situation": "msg_story", "affection_min": 0, "expression": "normal", "text": "今天讀書會結束後，留下來一下。" },
    { "id": "jingcheng-msg_story-002", "situation": "msg_story", "affection_min": 0, "expression": "shy", "text": "……我畫了一張圖。想給你看。" },
    { "id": "jingcheng-msg_story-003", "situation": "msg_story", "affection_min": 0, "expression": "normal", "text": "等你。老位子。" },

    { "id": "jingcheng-msg_streak-001", "situation": "msg_streak", "affection_min": 0, "expression": "happy", "text": "連續 {days} 天。很好。" },
    { "id": "jingcheng-msg_streak-002", "situation": "msg_streak", "affection_min": 0, "expression": "normal", "text": "{days} 天了。你現在複習得很穩定，繼續。" },
    { "id": "jingcheng-msg_streak-003", "situation": "msg_streak", "affection_min": 0, "expression": "happy", "text": "連續 {days} 天。我有在看。" },

    { "id": "jingcheng-msg_comeback-001", "situation": "msg_comeback", "affection_min": 0, "expression": "sad", "text": "好幾天沒看到你。" },
    { "id": "jingcheng-msg_comeback-002", "situation": "msg_comeback", "affection_min": 0, "expression": "sad", "text": "{days} 天沒來。位子還留著。" },
    { "id": "jingcheng-msg_comeback-003", "situation": "msg_comeback", "affection_min": 0, "expression": "normal", "text": "還好嗎。不用回，來就好。" },

    { "id": "jingcheng-gift-001", "situation": "gift", "affection_min": 0, "expression": "normal", "text": "……{gift}？給我的。……謝謝。我會用。" },
    { "id": "jingcheng-gift-002", "situation": "gift", "affection_min": 0, "expression": "surprised", "text": "送我東西做什麼。我又沒有幫你什麼。……收下了。", "affection_max": 1 },
    { "id": "jingcheng-gift-003", "situation": "gift", "affection_min": 2, "expression": "shy", "text": "……你記得我在這裡待到很晚。{gift}，剛好用得到。謝謝。" },
    { "id": "jingcheng-gift-004", "situation": "gift", "affection_min": 3, "expression": "shy", "text": "又送我東西。……下次讀書會，我把筆記多畫一份給你。只給你。" },
    { "id": "jingcheng-gift_liked-001", "situation": "gift_liked", "affection_min": 0, "expression": "happy", "gift": "sketchbook", "text": "紙很厚。用針筆畫也不會透到背面。……第一頁，我想畫臂神經叢給你看。" },
    { "id": "jingcheng-gift_liked-002", "situation": "gift_liked", "affection_min": 0, "expression": "normal", "gift": "glasses_cloth", "text": "拭鏡布。……剛好，我那條已經舊了。謝謝。", "affection_max": 1 },
    { "id": "jingcheng-gift_liked-003", "situation": "gift_liked", "affection_min": 2, "expression": "shy", "text": "……你一直在注意我的眼鏡嗎。擦乾淨了。……現在看你，很清楚。", "gift": "glasses_cloth" },
    { "id": "jingcheng-outfit-001", "situation": "outfit", "affection_min": 1, "expression": "normal", "outfit": "jingcheng_casual", "text": "洋裝。我平常只穿白袍。……假日去圖書館的時候，穿這件。你也會在嗎。" },
    { "id": "jingcheng-outfit-002", "situation": "outfit", "affection_min": 2, "expression": "shy", "outfit": "jingcheng_pajamas", "text": "睡衣。……送這個是什麼意思。我睡前會讀一小時解剖，穿這件讀。……不准想像。" }
  ]
}
