{
  "character": "yiqing",
  "lines": [
    { "id": "yiqing-start-001", "situation": "start", "affection_min": 0, "expression": "happy", "text": "{player}！今天的菜單是生理跟生化，熱身完就開跑囉！" },
    { "id": "yiqing-start-002", "situation": "start", "affection_min": 0, "expression": "happy", "text": "衝了啦！一回合就當一趟間歇跑，跑完再休息！" },
    { "id": "yiqing-start-003", "situation": "start", "affection_min": 0, "expression": "normal", "text": "先深呼吸——吸氣靠橫膈收縮，吐氣平常是被動的喔。好，開始！" },
    { "id": "yiqing-start-004", "situation": "start", "affection_min": 1, "expression": "shy", "text": "今天也來陪學姊讀書啦？……才、才沒有在等你，我剛好也在！" },
    { "id": "yiqing-start-005", "situation": "start", "affection_min": 1, "expression": "happy", "text": "{player}來啦！今天學姊多帶了一瓶運動飲料，剛好兩瓶！……真的是剛好！" },
    { "id": "yiqing-start-006", "situation": "start", "affection_min": 2, "expression": "happy", "text": "暖身做了沒？沒有的話跟學姊一起伸展——身體鬆開了，腦袋也會比較清醒喔！" },
    { "id": "yiqing-start-007", "situation": "start", "affection_min": 2, "expression": "shy", "text": "今天練完跑就直接衝來了，有點流汗……不要靠太近啦！" },
    { "id": "yiqing-start-008", "situation": "start", "affection_min": 3, "expression": "shy", "text": "{player}……今天可以坐我旁邊嗎？不是為了教你，是我想。" },

    { "id": "yiqing-comeback-001", "situation": "comeback", "affection_min": 0, "expression": "sad", "text": "{player}——！你跑去哪了啦！我一個人讀書好無聊，以後不准偷跑！" },
    { "id": "yiqing-comeback-002", "situation": "comeback", "affection_min": 0, "expression": "surprised", "text": "欸，你終於回來了！停練太久肌肉會掉的，讀書也一樣，快歸隊！" },
    { "id": "yiqing-comeback-003", "situation": "comeback", "affection_min": 0, "expression": "happy", "text": "沒關係沒關係，跑步也有休息日嘛！今天開始重新累積就好！" },
    { "id": "yiqing-comeback-004", "situation": "comeback", "affection_min": 1, "expression": "sad", "text": "你終於回來了！學姊這幾天一個人繞操場，繞到都不知道第幾圈了！" },
    { "id": "yiqing-comeback-005", "situation": "comeback", "affection_min": 3, "expression": "sad", "text": "……你回來了。我還以為你不要學姊了。……好啦，我沒事！今天加倍練回來！" },

    { "id": "yiqing-correct-001", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "漂亮！這題的配速完美！" },
    { "id": "yiqing-correct-002", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "答對！保持這個節奏，不要減速喔！" },
    { "id": "yiqing-correct-003", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "好耶！學姊幫你按碼表了，這題 PB！" },
    { "id": "yiqing-correct-004", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "正確！記得題目怎麼考的，下次看到就直接衝過去。" },
    { "id": "yiqing-correct-005", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "對啦！你看，你明明就會嘛！" },
    { "id": "yiqing-correct-006", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "完美過彎！下一題繼續！" },
    { "id": "yiqing-correct-007", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "穩穩的。克氏循環一圈也是穩穩地給你 3 個 NADH、1 個 FADH₂ 跟 1 個 GTP 喔！" },
    { "id": "yiqing-correct-008", "situation": "correct", "affection_min": 1, "expression": "shy", "text": "答對了……{player}認真的樣子，還、還蠻帥的嘛。好啦下一題！" },
    { "id": "yiqing-correct-009", "situation": "correct", "affection_min": 1, "expression": "happy", "text": "答對！你現在讀書的節奏，比剛認識的時候穩好多！" },
    { "id": "yiqing-correct-010", "situation": "correct", "affection_min": 1, "expression": "normal", "text": "正確！順便記：糖解作用在細胞質，克氏循環在粒線體基質，跑錯場地會被判犯規喔！" },
    { "id": "yiqing-correct-011", "situation": "correct", "affection_min": 2, "expression": "happy", "text": "好耶！這題學姊上次跟你講過對吧？你有記住，我超開心的！" },
    { "id": "yiqing-correct-012", "situation": "correct", "affection_min": 2, "expression": "normal", "text": "對！順便記：溫度升高、CO₂ 升高、pH 下降、2,3-BPG 增加，氧解離曲線都會右移，血紅素比較願意把氧放給肌肉！" },
    { "id": "yiqing-correct-013", "situation": "correct", "affection_min": 3, "expression": "shy", "text": "答對了……來擊掌——手、手怎麼又握住了啦。……再一下下就好。" },
    { "id": "yiqing-correct-014", "situation": "correct", "affection_min": 3, "expression": "happy", "text": "漂亮！順便記：ADH 作用在集尿管，讓 aquaporin-2 插到細胞膜上，水就被吸回去了！" },

    { "id": "yiqing-wrong-001", "situation": "wrong", "affection_min": 0, "expression": "sad", "text": "哎呀，跌倒了！沒關係，跌倒就站起來，再跑一次！" },
    { "id": "yiqing-wrong-002", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "這題記下來，學姊幫你排進複習。明天再來挑戰一次！" },
    { "id": "yiqing-wrong-003", "situation": "wrong", "affection_min": 0, "expression": "sad", "text": "可惜！差一點點，就像衝線前被追過的那種差一點。" },
    { "id": "yiqing-wrong-004", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "沒事！錯的題目才是最好的訓練菜單。看一下正解，記起來！" },
    { "id": "yiqing-wrong-005", "situation": "wrong", "affection_min": 0, "expression": "surprised", "text": "咦？這題我也錯過！……當年。所以一起把它記起來吧！" },
    { "id": "yiqing-wrong-006", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "抽筋了嗎？肌肉收縮要靠鈣離子和肌鈣蛋白 C 結合，腦袋卡住就靠複習把它接回來！" },
    { "id": "yiqing-wrong-007", "situation": "wrong", "affection_min": 1, "expression": "sad", "text": "不要露出那種表情嘛……學姊陪你再看一次，好不好？" },
    { "id": "yiqing-wrong-008", "situation": "wrong", "affection_min": 1, "expression": "normal", "text": "沒關係！順便記：心肌有平台期，L 型鈣通道打開、鈣離子流進來，不反應期很長，所以心肌不會強直收縮！" },
    { "id": "yiqing-wrong-009", "situation": "wrong", "affection_min": 1, "expression": "sad", "text": "哎唷，跌倒了。來，學姊拉你起來——手給我！" },
    { "id": "yiqing-wrong-010", "situation": "wrong", "affection_min": 2, "expression": "normal", "text": "再看一次正解！順便記：醛固酮讓遠端腎元把鈉吸回來、把鉀排出去，鈉跟鉀是反方向跑的！" },
    { "id": "yiqing-wrong-011", "situation": "wrong", "affection_min": 2, "expression": "sad", "text": "錯了也不要垂頭喪氣嘛……你難過的時候，學姊也跑不動了。" },
    { "id": "yiqing-wrong-012", "situation": "wrong", "affection_min": 3, "expression": "shy", "text": "沒關係！我會一直陪你練到會為止。不管幾圈，我都陪你跑。" },
    { "id": "yiqing-wrong-013", "situation": "wrong", "affection_min": 3, "expression": "normal", "text": "這題要記：肝醣分解的速率限制酶是肝醣磷解酶。學姊比賽的時候，肌肉也是靠它把肝醣變成能量的！" },

    { "id": "yiqing-streak-001", "situation": "streak", "affection_min": 0, "expression": "happy", "text": "連對十題！來，擊掌——欸，手不用握這麼久啦，笨蛋，我的心跳都要用生理學來解釋了。" },
    { "id": "yiqing-streak-002", "situation": "streak", "affection_min": 0, "expression": "happy", "text": "十連對！你現在就像回心血量變多的心臟，越撐越有力——Frank-Starling！" },
    { "id": "yiqing-streak-003", "situation": "streak", "affection_min": 0, "expression": "surprised", "text": "等等，十題全對？{player}你今天是不是偷偷吃了什麼！" },
    { "id": "yiqing-streak-004", "situation": "streak", "affection_min": 1, "expression": "shy", "text": "又連對了……這樣下去學姊要沒東西可以教你了啦。……那你還會來找我嗎？" },
    { "id": "yiqing-streak-005", "situation": "streak", "affection_min": 2, "expression": "happy", "text": "十連對！學姊要把這個紀錄寫在白板上，旁邊畫一個大大的愛心！……是獎勵的那種愛心啦！" },
    { "id": "yiqing-streak-006", "situation": "streak", "affection_min": 3, "expression": "shy", "text": "又連對了！{player}越來越厲害了……學姊也要更努力，才配得上當你的學姊。" },

    { "id": "yiqing-finish-001", "situation": "finish", "affection_min": 0, "expression": "happy", "text": "一回合跑完！收操時間，喝口水再繼續！" },
    { "id": "yiqing-finish-002", "situation": "finish", "affection_min": 0, "expression": "normal", "text": "辛苦了！錯的題目學姊都幫你記下來了，複習的時候見！" },
    { "id": "yiqing-finish-003", "situation": "finish", "affection_min": 0, "expression": "happy", "text": "今天的訓練量達標！明天也要來喔，說好了！" },
    { "id": "yiqing-finish-004", "situation": "finish", "affection_min": 1, "expression": "happy", "text": "收操！今天也辛苦了，{player}！明天同一時間操場見——啊不對，是讀書會見！" },
    { "id": "yiqing-finish-005", "situation": "finish", "affection_min": 2, "expression": "normal", "text": "跑完一回合了！……那個，你回去的路上要小心喔。到了傳訊息給我。" },
    { "id": "yiqing-finish-006", "situation": "finish", "affection_min": 3, "expression": "shy", "text": "今天就到這裡……好捨不得喔。心跳一直降不下來……這次我不想用交感神經來解釋了。" },

    { "id": "yiqing-mock_high-001", "situation": "mock_high", "affection_min": 0, "expression": "surprised", "text": "這個分數！我要繞操場跑三圈慶祝！你也要一起！" },
    { "id": "yiqing-mock_high-002", "situation": "mock_high", "affection_min": 0, "expression": "happy", "text": "看吧！我就說你是一階選手的料！" },

    { "id": "yiqing-msg_review-001", "situation": "msg_review", "affection_min": 0, "expression": "normal", "text": "{player}！今天有 {n} 題錯題到期了，複習就像收操，不做會抽筋喔！圖書館見！" },
    { "id": "yiqing-msg_review-002", "situation": "msg_review", "affection_min": 0, "expression": "happy", "text": "叮咚～教練提醒：{n} 題錯題該複習了！趁記憶還熱，衝一波！" },
    { "id": "yiqing-msg_review-003", "situation": "msg_review", "affection_min": 0, "expression": "happy", "text": "今天的訓練菜單：錯題 {n} 題。做完我請你喝運動飲料！" },

    { "id": "yiqing-msg_story-001", "situation": "msg_story", "affection_min": 0, "expression": "shy", "text": "欸欸，今天練完跑……你有空嗎？有件事想跟你說，來找我！" },
    { "id": "yiqing-msg_story-002", "situation": "msg_story", "affection_min": 0, "expression": "shy", "text": "{player}，我在等你喔。不是要你陪跑啦……來就對了！" },
    { "id": "yiqing-msg_story-003", "situation": "msg_story", "affection_min": 0, "expression": "happy", "text": "今天想跟你多聊一下。來找我吧，我等你！" },

    { "id": "yiqing-msg_streak-001", "situation": "msg_streak", "affection_min": 0, "expression": "happy", "text": "連續 {days} 天了！這個節奏太完美了，我們繼續保持配速！" },
    { "id": "yiqing-msg_streak-002", "situation": "msg_streak", "affection_min": 0, "expression": "surprised", "text": "{days} 天都沒斷！{player} 你根本是一階選手了吧！" },
    { "id": "yiqing-msg_streak-003", "situation": "msg_streak", "affection_min": 0, "expression": "happy", "text": "連續 {days} 天！今天也辛苦了，記得伸展、早點睡！" },

    { "id": "yiqing-msg_comeback-001", "situation": "msg_comeback", "affection_min": 0, "expression": "sad", "text": "{player}，最近都沒看到你耶……還好嗎？休息夠了就回來跑吧，我等你！" },
    { "id": "yiqing-msg_comeback-002", "situation": "msg_comeback", "affection_min": 0, "expression": "sad", "text": "好幾天沒一起讀書了！我的配速都亂掉了啦，快回來！" },
    { "id": "yiqing-msg_comeback-003", "situation": "msg_comeback", "affection_min": 0, "expression": "normal", "text": "欸，你還好嗎？今天來操場露個臉就好，寫一題也算數！" },

    { "id": "yiqing-gift-001", "situation": "gift", "affection_min": 0, "expression": "happy", "text": "哇！{gift}！給我的嗎？{player}最棒了！補給收到！" },
    { "id": "yiqing-gift-002", "situation": "gift", "affection_min": 0, "expression": "surprised", "text": "欸欸？突然送東西，我會不好意思耶！……好啦謝謝，我會好好珍惜的！" },
    { "id": "yiqing-gift-003", "situation": "gift", "affection_min": 2, "expression": "shy", "text": "每次都送我東西……我也要回禮才行。下一場比賽，我跑第一名給你看！" },
    { "id": "yiqing-gift-004", "situation": "gift", "affection_min": 3, "expression": "shy", "text": "{gift}……謝謝。那個，我現在心跳有點快，不是因為剛跑完步喔。" },
    { "id": "yiqing-gift_liked-001", "situation": "gift_liked", "affection_min": 0, "expression": "happy", "gift": "sports_drink", "text": "運動飲料！你懂我！流汗會流失鈉和鉀，補水也要補電解質——這就是生理學！" },
    { "id": "yiqing-gift_liked-002", "situation": "gift_liked", "affection_min": 0, "expression": "happy", "gift": "wristband", "text": "新護腕！我這條都洗到鬆了……你有在注意我的手腕喔？下一場比賽就戴這條！" }
  ]
}
