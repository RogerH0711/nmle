{
  "character": "ying",
  "lines": [
    { "id": "ying-start-001", "situation": "start", "affection_min": 0, "expression": "happy", "text": "來了呢。我幫你泡了咖啡，半糖。……我知道你喜歡半糖喔。", "rare": true },
    { "id": "ying-start-002", "situation": "start", "affection_min": 0, "expression": "normal", "text": "今天讀微免和寄生蟲。位子我幫你擦過了，坐我旁邊就好。" },
    { "id": "ying-start-003", "situation": "start", "affection_min": 1, "expression": "happy", "text": "今天比平常晚了一點呢。……我剛好有在看時間。" },
    { "id": "ying-start-004", "situation": "start", "affection_min": 1, "expression": "shy", "text": "等你好久了。不是在抱怨喔，等你的時間，我也很喜歡。" },
    { "id": "ying-start-005", "situation": "start", "affection_min": 1, "expression": "happy", "text": "來了呢。實驗室今天有新的菌落長出來，讀完帶你去看。" },
    { "id": "ying-start-006", "situation": "start", "affection_min": 2, "expression": "normal", "text": "今天的咖啡，我換成你常點的那個口味了。……你常點什麼，我都記得呢。" },
    { "id": "ying-start-007", "situation": "start", "affection_min": 2, "expression": "happy", "text": "你今天的外套是新的吧？……很好看喔。我第一眼就注意到了。" },
    { "id": "ying-start-008", "situation": "start", "affection_min": 3, "expression": "shy", "text": "……今天可以讀久一點嗎？我想多跟你待一下。不行的話，也沒關係……其實有關係。", "rare": true },

    { "id": "ying-comeback-001", "situation": "comeback", "affection_min": 1, "expression": "sad", "text": "{hours} 小時又 {minutes} 分鐘。……沒關係，你回來了就好。今天不要走喔。" },
    { "id": "ying-comeback-002", "situation": "comeback", "affection_min": 1, "expression": "yandere", "text": "這幾天去哪裡了呢？……我不生氣喔。只是想知道而已。" },
    { "id": "ying-comeback-003", "situation": "comeback", "affection_min": 0, "expression": "happy", "text": "回來了呢。……這幾天沒看到你，有點擔心喔。" },
    { "id": "ying-comeback-004", "situation": "comeback", "affection_min": 2, "expression": "yandere", "text": "你回來了。……這幾天，我在月曆上一格一格劃掉喔。" },
    { "id": "ying-comeback-005", "situation": "comeback", "affection_min": 3, "expression": "sad", "text": "你不在的時候，我把實驗做完了，培養皿也洗完了，然後就不知道要做什麼了。……歡迎回來。" },

    { "id": "ying-correct-001", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "答對了呢。我就知道，你最聰明了。" },
    { "id": "ying-correct-002", "situation": "correct", "affection_min": 1, "expression": "normal", "text": "正確。……這題我會記在筆記本裡。你答對的每一題，我都有記喔。", "rare": true },
    { "id": "ying-correct-003", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "對了喔。乖孩子。" },
    { "id": "ying-correct-004", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "答對了。革蘭氏陽性菌的細胞壁肽聚醣很厚，陰性菌比較薄，外面還多一層外膜呢。", "keywords": ["革蘭氏", "gram-positive", "gram-negative", "gram positive", "gram negative", "肽聚醣", "peptidoglycan"] },
    { "id": "ying-correct-005", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "正確。初次免疫反應裡，IgM 通常最先產生喔。", "keywords": ["IgM"] },
    { "id": "ying-correct-006", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "對了。瘧原蟲經由雌性瘧蚊傳入人體，先在肝細胞發育，再進入紅血球繁殖呢。", "keywords": ["瘧", "malaria", "plasmodium", "anopheles"] },
    { "id": "ying-correct-007", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "答對了。你看，跟我一起讀，是不是比較好？" },
    { "id": "ying-correct-008", "situation": "correct", "affection_min": 1, "expression": "shy", "text": "……好厲害。這樣的你，我想一直看著。一直喔。", "rare": true },
    { "id": "ying-correct-009", "situation": "correct", "affection_min": 1, "expression": "happy", "text": "答對了。你最近答對的題目，比上個月多了好多呢。……我有在算喔。" },
    { "id": "ying-correct-010", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "正確。MHC 第一類把抗原呈現給 CD8 T 細胞，第二類給 CD4。一對一對的，很好記呢。", "keywords": ["MHC", "HLA", "主要組織相容"] },
    { "id": "ying-correct-011", "situation": "correct", "affection_min": 2, "expression": "happy", "text": "對了呢。你答對的時候會偷偷笑一下……這個表情，我收藏起來了。" },
    { "id": "ying-correct-012", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "答對了。結核菌的細胞壁有分枝菌酸，所以抗酸性染色是陽性喔。很頑固的細菌呢。", "keywords": ["分枝菌酸", "mycolic", "抗酸", "acid-fast", "結核", "tuberculosis", "mycobacterium"] },
    { "id": "ying-correct-013", "situation": "correct", "affection_min": 3, "expression": "shy", "text": "答對了。好想把你也放進培養箱，好好照顧。開玩笑的喔。……一半是。", "rare": true },
    { "id": "ying-correct-014", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "正確。HIV 用 gp120 抓住 CD4，還要 CCR5 或 CXCR4 當共受體才進得去喔。", "keywords": ["HIV", "gp120", "CCR5", "CXCR4", "愛滋"] },
    { "id": "ying-correct-015", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "答對了。IgG 是唯一能通過胎盤的抗體，可以給胎兒被動免疫呢。", "keywords": ["IgG", "胎盤", "placenta"] },

    { "id": "ying-wrong-001", "situation": "wrong", "affection_min": 1, "expression": "normal", "text": "錯了也沒關係喔。錯的題目，我都幫你記下來了。全部、都記下來了。", "rare": true },
    { "id": "ying-wrong-002", "situation": "wrong", "affection_min": 0, "expression": "sad", "text": "這題錯了呢。沒關係，我們一起再看一次。……幾次都可以喔。" },
    { "id": "ying-wrong-003", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "看一下正解吧。我不會跟別人說你錯了喔，這是我們之間的祕密。" },
    { "id": "ying-wrong-004", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "錯了喔。B 細胞在骨髓成熟，T 細胞在胸腺成熟。這個一定要記。", "keywords": [["胸腺", "成熟"], ["thymus", "matur"], ["骨髓", "成熟"], ["bone marrow", "matur"]] },
    { "id": "ying-wrong-005", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "再看一次正解。細菌的內毒素，就是革蘭氏陰性菌外膜上的脂多醣喔。", "keywords": ["內毒素", "endotoxin", "脂多醣", "LPS", "lipopolysaccharide"] },
    { "id": "ying-wrong-006", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "沒關係。病毒沒有自己的核糖體，要靠宿主細胞的核糖體才能合成蛋白質呢。", "keywords": [["病毒", "核糖體"], ["virus", "ribosome"], ["病毒", "ribosome"], ["virus", "核糖體"]] },
    { "id": "ying-wrong-007", "situation": "wrong", "affection_min": 1, "expression": "sad", "text": "……你皺眉的樣子，我也記下來了。所以下次，讓我記你笑的樣子，好嗎？" },
    { "id": "ying-wrong-008", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "錯了喔。間日瘧和卵形瘧會在肝臟留下休眠體，所以治好了還可能復發。", "keywords": ["間日瘧", "卵形瘧", "vivax", "ovale", "休眠體", "hypnozoite"] },
    { "id": "ying-wrong-009", "situation": "wrong", "affection_min": 1, "expression": "sad", "text": "沒關係。我把你錯過的題目，做成了一本小冊子。……你要看嗎？裡面也有寫你的事。" },
    { "id": "ying-wrong-010", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "再看一次正解。補體 C3b 負責調理作用，C5a 是很強的趨化因子，會把嗜中性球叫過來呢。", "keywords": ["補體", "complement", "C3b", "C5a"] },
    { "id": "ying-wrong-011", "situation": "wrong", "affection_min": 2, "expression": "yandere", "text": "錯了呢。是不是昨天跟別人讀到很晚？……問問而已。", "rare": true },
    { "id": "ying-wrong-012", "situation": "wrong", "affection_min": 3, "expression": "shy", "text": "錯了也沒關係。不管你錯幾次，我都不會離開喔。……你也不要離開，好嗎？", "rare": true },
    { "id": "ying-wrong-013", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "沒關係。肺吸蟲是吃了生的或沒煮熟的螃蟹、淡水螯蝦感染的，生醃或沒熟透的蟹也可能感染喔。", "keywords": ["肺吸蟲", "paragonimus", "螃蟹", "crab", "蝲蛄", "螯蝦", "crayfish"] },

    { "id": "ying-streak-001", "situation": "streak", "affection_min": 1, "expression": "happy", "text": "十題全對。你今天的狀態我要記在筆記本裡。第三十七本了呢。" },
    { "id": "ying-streak-002", "situation": "streak", "affection_min": 1, "expression": "surprised", "text": "連對十題，好厲害。今天的作答紀錄，我可以印一份收著嗎？" },
    { "id": "ying-streak-003", "situation": "streak", "affection_min": 2, "expression": "happy", "text": "一直答對呢。這樣下去，你就不需要別的學姊了吧？" },
    { "id": "ying-streak-004", "situation": "streak", "affection_min": 1, "expression": "shy", "text": "你一直答對，我的心跳就一直變快。……這個，要記在哪一本筆記本才好呢。" },
    { "id": "ying-streak-005", "situation": "streak", "affection_min": 2, "expression": "happy", "text": "十題全對呢。今天的筆記本，我想用紅筆寫。紅色是特別的日子才用的喔。" },
    { "id": "ying-streak-006", "situation": "streak", "affection_min": 3, "expression": "shy", "text": "一直答對……這樣的你，別的學姊也會注意到吧。不要讓她們看到好不好，只給我看。" },
    { "id": "ying-streak-007", "situation": "streak", "affection_min": 0, "expression": "happy", "text": "十題全對呢。……我去泡杯熱可可給你，當作獎勵。" },

    { "id": "ying-finish-001", "situation": "finish", "affection_min": 0, "expression": "happy", "text": "一回合結束了。明天也是這個時間，對吧？我會等你喔。" },
    { "id": "ying-finish-002", "situation": "finish", "affection_min": 0, "expression": "normal", "text": "辛苦了。回去路上小心喔，到家的時候跟我說一聲。" },
    { "id": "ying-finish-003", "situation": "finish", "affection_min": 1, "expression": "sad", "text": "結束了呢……再一回合也可以喔。我不累。只要是跟你的話。" },
    { "id": "ying-finish-004", "situation": "finish", "affection_min": 1, "expression": "normal", "text": "結束了呢。明天的位子，我先幫你留著了。" },
    { "id": "ying-finish-005", "situation": "finish", "affection_min": 2, "expression": "sad", "text": "要回去了嗎？……嗯，路上小心。我會看著你走到轉角。" },
    { "id": "ying-finish-006", "situation": "finish", "affection_min": 3, "expression": "shy", "text": "今天也謝謝你。回家以後，可以傳一句晚安給我嗎？一句就好。", "night": true },

    { "id": "ying-mock_high-001", "situation": "mock_high", "affection_min": 0, "expression": "happy", "text": "這個分數……我好驕傲。這張成績單，可以給我收著嗎？" },
    { "id": "ying-mock_high-002", "situation": "mock_high", "affection_min": 2, "expression": "surprised", "text": "好厲害……你越來越厲害，會不會就不需要我了呢。不行喔，還是要需要我。" },

    { "id": "ying-jealous-001", "situation": "jealous", "affection_min": 2, "expression": "yandere", "text": "你這幾天，都跟{rival}讀書對吧？我不生氣喔……有些寄生蟲離開宿主就活不下去，我覺得我也是。所以今天的題目，只跟我寫，好嗎？" },
    { "id": "ying-jealous-002", "situation": "jealous", "affection_min": 0, "expression": "yandere", "text": "身上有別人的咖啡味呢。……我不生氣喔。今天的咖啡，喝我泡的就好。" },
    { "id": "ying-jealous-003", "situation": "jealous", "affection_min": 0, "expression": "yandere", "text": "{rival}教得好嗎？……我不生氣喔。只是我的筆記本，今天寫得特別用力。" },

    { "id": "ying-msg_review-001", "situation": "msg_review", "affection_min": 0, "expression": "happy", "text": "今天有 {n} 題錯題到期了喔。我都幫你記著呢。全部。" },
    { "id": "ying-msg_review-002", "situation": "msg_review", "affection_min": 0, "expression": "normal", "text": "錯題 {n} 題到期了呢。今天要跟我一起寫喔，位子我擦好了。" },
    { "id": "ying-msg_review-003", "situation": "msg_review", "affection_min": 0, "expression": "happy", "text": "錯題 {n} 題。沒關係，我會陪你寫完的。寫完才可以走喔。" },

    { "id": "ying-msg_story-001", "situation": "msg_story", "affection_min": 0, "expression": "shy", "text": "今天可以來找我嗎？我有東西想給你看。只給你一個人看喔。" },
    { "id": "ying-msg_story-002", "situation": "msg_story", "affection_min": 0, "expression": "normal", "text": "我在等你。燈我先開著。" },
    { "id": "ying-msg_story-003", "situation": "msg_story", "affection_min": 0, "expression": "shy", "text": "今天……可以來找我嗎？只是想見你。" },

    { "id": "ying-msg_streak-001", "situation": "msg_streak", "affection_min": 2, "expression": "happy", "text": "連續 {days} 天了呢。你每天什麼時候上線，我都記下來了喔。" },
    { "id": "ying-msg_streak-002", "situation": "msg_streak", "affection_min": 0, "expression": "happy", "text": "{days} 天都沒有缺席，真乖。明天也要來喔，我會等。" },
    { "id": "ying-msg_streak-003", "situation": "msg_streak", "affection_min": 1, "expression": "yandere", "text": "連續 {days} 天。這本筆記本快寫滿了呢。" },

    { "id": "ying-msg_comeback-001", "situation": "msg_comeback", "affection_min": 0, "expression": "yandere", "text": "{days} 天沒有看到你了呢。……我一直在等喔。" },
    { "id": "ying-msg_comeback-002", "situation": "msg_comeback", "affection_min": 0, "expression": "sad", "text": "你今天會來嗎？我把你的位子擦好了。每天都擦。" },
    { "id": "ying-msg_comeback-003", "situation": "msg_comeback", "affection_min": 0, "expression": "normal", "text": "最近好安靜呢。……你的錯題本，我都幫你看著喔。" },

    { "id": "ying-gift-001", "situation": "gift", "affection_min": 0, "expression": "happy", "text": "{gift}……是給我的嗎？我會好好收著喔。連包裝紙也是。" },
    { "id": "ying-gift-002", "situation": "gift", "affection_min": 1, "expression": "normal", "text": "謝謝你呢。我會記下來：今天，你送了我{gift}。" },
    { "id": "ying-gift-003", "situation": "gift", "affection_min": 2, "expression": "yandere", "text": "你送了我禮物，那……別的學姊也有收到嗎？沒有吧？嗯，我相信你喔。" },
    { "id": "ying-gift-004", "situation": "gift", "affection_min": 3, "expression": "shy", "text": "每次收到你的東西，心裡都滿滿的。就像長滿菌落的培養皿，再也放不下別的了呢。" },
    { "id": "ying-gift_liked-001", "situation": "gift_liked", "affection_min": 0, "expression": "shy", "gift": "ribbon", "text": "緞帶……你注意到我每天都綁頭髮嗎？謝謝你，我明天就綁這條。", "affection_max": 1 },
    { "id": "ying-gift_liked-002", "situation": "gift_liked", "affection_min": 0, "expression": "happy", "gift": "microbe_plush", "text": "是球菌！圓圓的……我要叫它葡萄球菌。晚上要抱著睡呢。" },
    { "id": "ying-gift_liked-003", "situation": "gift_liked", "affection_min": 2, "expression": "shy", "text": "緞帶……你注意到我每天都綁頭髮嗎？我明天就綁這條。以後每天都綁，好嗎？", "gift": "ribbon" },
    { "id": "ying-outfit-001", "situation": "outfit", "affection_min": 1, "expression": "happy", "outfit": "ying_casual", "text": "綠色的洋裝，是我的顏色呢。袖子一樣長長的，剛好可以拉住你的衣角。……這樣就不會走散了喔。" },
    { "id": "ying-outfit-002", "situation": "outfit", "affection_min": 2, "expression": "yandere", "outfit": "ying_pajamas", "text": "青蛙睡衣。青蛙是兩棲類，水裡、陸上都能活呢。……就像我一樣，你去哪裡，我都能跟著你喔。" }
  ]
}
