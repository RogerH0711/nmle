  {
    "character": "yiqing",
    "lines": [
      { "id": "yiqing-start-001", "situation": "start", "affection_min": 0, "expression": "happy", "text": "{player}！今天是生理跟生化，先寫一回合暖身！" },
      { "id": "yiqing-start-002", "situation": "start", "affection_min": 0, "expression": "happy", "text": "衝了啦！寫完這回合，我請你喝飲料！" },
      { "id": "yiqing-start-003", "situation": "start", "affection_min": 0, "expression": "normal", "text": "先深呼吸一下。好，肩膀放鬆了，開始吧！" },
      { "id": "yiqing-start-004", "situation": "start", "affection_min": 1, "expression": "happy", "text": "你今天氣色不錯耶，睡飽了齁？那今天多寫一點！" },
      { "id": "yiqing-start-005", "situation": "start", "affection_min": 1, "expression": "happy", "text": "{player}來啦！我多買了一瓶運動飲料，給你。" },
      { "id": "yiqing-start-006", "situation": "start", "affection_min": 2, "expression": "happy", "text": "你肩膀好緊喔，是不是又熬夜了？來，先跟我一起伸展一下。" },
      { "id": "yiqing-start-007", "situation": "start", "affection_min": 2, "expression": "shy", "text": "我練完跑直接衝過來的，有點流汗……你、你坐那邊一點啦。" },
      { "id": "yiqing-start-008", "situation": "start", "affection_min": 3, "expression": "shy", "text": "{player}……今天可以坐我旁邊嗎？不是為了教你，是我想。", "rare": true },

      { "id": "yiqing-comeback-001", "situation": "comeback", "affection_min": 0, "expression": "sad", "text": "{player}——！你跑去哪了啦！好幾天沒看到你耶！", "affection_max": 1 },
      { "id": "yiqing-comeback-002", "situation": "comeback", "affection_min": 0, "expression": "surprised", "text": "欸，你回來了！沒事吧？最近很忙喔？" },
      { "id": "yiqing-comeback-003", "situation": "comeback", "affection_min": 0, "expression": "happy", "text": "沒關係沒關係，休息幾天很正常！今天從簡單的開始！" },
      { "id": "yiqing-comeback-004", "situation": "comeback", "affection_min": 1, "expression": "sad", "text": "你終於回來了！我這幾天一個人讀，讀到一半都會想說你在幹嘛。" },
      { "id": "yiqing-comeback-005", "situation": "comeback", "affection_min": 3, "expression": "sad", "text": "……你回來了。我還以為你不想來了。好啦，我沒事！今天一起寫！" },

      { "id": "yiqing-correct-001", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "漂亮！這題很快耶！" },
      { "id": "yiqing-correct-002", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "答對！剛剛那個判斷很穩，記住這個思路。" },
      { "id": "yiqing-correct-003", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "好耶！這種題目我以前都會錯，你比我強！" },
      { "id": "yiqing-correct-004", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "正確！這種題型記起來，下次看到就不用想了。" },
      { "id": "yiqing-correct-005", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "對啦！你看，你明明就會嘛！" },
      { "id": "yiqing-correct-006", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "下一題！手感來了喔！" },
      { "id": "yiqing-correct-007", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "穩穩的！克氏循環每進一個乙醯輔酶 A，會產生 3 個 NADH、1 個 FADH₂ 跟 1 個 GTP。這個數字一定要背熟！", "keywords": ["克氏循環", "檸檬酸循環", "TCA", "Krebs", "citric acid cycle"] },
      { "id": "yiqing-correct-008", "situation": "correct", "affection_min": 1, "expression": "shy", "text": "答對了……你認真的時候都會皺眉頭耶。啊，沒有啦，下一題！" },
      { "id": "yiqing-correct-009", "situation": "correct", "affection_min": 1, "expression": "happy", "text": "答對！你現在讀書的節奏，比剛認識的時候穩好多！" },
      { "id": "yiqing-correct-010", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "正確！糖解作用在細胞質，克氏循環在粒線體基質，地點也很常考喔。", "keywords": ["糖解", "glycolysis", "粒線體基質", "mitochondrial matrix"] },
      { "id": "yiqing-correct-011", "situation": "correct", "affection_min": 2, "expression": "happy", "text": "好耶！你最近答對的時候都會偷偷握拳，我都有看到喔。" },
      { "id": "yiqing-correct-012", "situation": "correct", "affection_min": 0, "expression": "normal", "text": "對！溫度升高、CO₂ 升高、pH 下降、2,3-BPG 增加，氧解離曲線都會右移。跑步的時候，這些變化能幫血紅素把氧釋放給正在工作的肌肉！", "keywords": ["氧解離", "解離曲線", "2,3-BPG", "2,3-DPG", "Bohr", "波爾效應"] },
      { "id": "yiqing-correct-013", "situation": "correct", "affection_min": 3, "expression": "shy", "text": "答對了……來擊掌——手、手怎麼又握住了啦。……再一下下就好。", "rare": true },
      { "id": "yiqing-correct-014", "situation": "correct", "affection_min": 0, "expression": "happy", "text": "漂亮！抗利尿激素作用在集尿管，讓 aquaporin-2 插到細胞膜上，水就被吸回去了。", "keywords": ["抗利尿激素", "antidiuretic", "vasopressin", "血管加壓素", "AQP2", "aquaporin-2", "aquaporin 2", "水通道蛋白-2", "水通道蛋白二型"] },

      { "id": "yiqing-wrong-001", "situation": "wrong", "affection_min": 0, "expression": "sad", "text": "哎呀，可惜！沒關係沒關係。" },
      { "id": "yiqing-wrong-002", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "這題記下來，學姊幫你排進複習。明天再來挑戰一次！" },
      { "id": "yiqing-wrong-003", "situation": "wrong", "affection_min": 0, "expression": "sad", "text": "可惜！先看一下正解，對照你剛剛選的那個，差在哪裡。" },
      { "id": "yiqing-wrong-004", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "沒事！想想看是哪裡卡住了——是沒背到，還是題目看太快？" },
      { "id": "yiqing-wrong-005", "situation": "wrong", "affection_min": 0, "expression": "surprised", "text": "咦？這題我以前也錯過！所以一起記起來吧！" },
      { "id": "yiqing-wrong-006", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "看正解！骨骼肌收縮是鈣離子跟肌鈣蛋白 C 結合，把原肌凝蛋白移開，肌動蛋白和肌凝蛋白才接得上。", "keywords": ["肌鈣蛋白", "troponin", "原肌凝蛋白", "tropomyosin", "興奮收縮", "excitation-contraction"] },
      { "id": "yiqing-wrong-007", "situation": "wrong", "affection_min": 1, "expression": "sad", "text": "不要露出那種表情嘛……我陪你再看一次，好不好？" },
      { "id": "yiqing-wrong-008", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "沒關係！心肌有平台期，L 型鈣通道打開、鈣離子流進來，不反應期很長，所以心肌不會強直收縮。", "keywords": ["平台期", "plateau", "L 型鈣", "L-type", "強直收縮", "tetanic", ["心肌", "不反應期"], ["cardiac", "refractory"]] },
      { "id": "yiqing-wrong-009", "situation": "wrong", "affection_min": 1, "expression": "sad", "text": "哎唷。沒事沒事，這種的多寫幾題就有感覺了。" },
      { "id": "yiqing-wrong-010", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "再看一次正解！醛固酮讓遠端腎元把鈉吸回來、把鉀排出去，鈉跟鉀是反方向的。", "keywords": ["醛固酮", "aldosterone"] },
      { "id": "yiqing-wrong-011", "situation": "wrong", "affection_min": 2, "expression": "sad", "text": "你今天是不是有點累？累的話寫完這回合就休息，不要硬撐喔。" },
      { "id": "yiqing-wrong-012", "situation": "wrong", "affection_min": 3, "expression": "shy", "text": "沒關係！我會一直陪你練到會為止。不管幾圈，我都陪你跑。", "rare": true },
      { "id": "yiqing-wrong-013", "situation": "wrong", "affection_min": 0, "expression": "normal", "text": "這題要記：肝醣分解的速率限制酶是肝醣磷解酶。它把肝醣切成葡萄糖-1-磷酸，再轉成葡萄糖-6-磷酸進入糖解作用。", "keywords": ["肝醣磷解酶", "肝醣磷酸化酶", "glycogen phosphorylase", "肝醣分解", "glycogenolysis"] },
      { "id": "yiqing-wrong-014", "situation": "wrong", "affection_min": 3, "expression": "normal", "keywords": ["肝醣磷解酶", "肝醣磷酸化酶", "glycogen phosphorylase", "肝醣分解", "glycogenolysis"], "text": "肝醣磷解酶這個我超熟的！跑長距離的時候，肌肉就是一直靠它把存起來的肝醣拿出來用。……所以這題，我們一起記。" },

      { "id": "yiqing-streak-001", "situation": "streak", "affection_min": 0, "expression": "happy", "text": "連對十題！來，擊掌！——好痛，你也太用力了吧！" },
      { "id": "yiqing-streak-002", "situation": "streak", "affection_min": 0, "expression": "happy", "text": "十連對！你今天狀態超好耶！" },
      { "id": "yiqing-streak-003", "situation": "streak", "affection_min": 0, "expression": "surprised", "text": "等等，十題全對？{player}你今天是不是偷偷吃了什麼！" },
      { "id": "yiqing-streak-004", "situation": "streak", "affection_min": 1, "expression": "shy", "text": "又連對了！這樣下去學姊要沒東西可以教你了啦。……那你還會來找我嗎？" },
      { "id": "yiqing-streak-005", "situation": "streak", "affection_min": 2, "expression": "happy", "text": "十連對！我要把這個寫在白板上！旁邊再畫一個大大的愛心！" },
      { "id": "yiqing-streak-006", "situation": "streak", "affection_min": 3, "expression": "shy", "text": "又連對了！{player}越來越厲害了，我也要更努力才行。" },

      { "id": "yiqing-finish-001", "situation": "finish", "affection_min": 0, "expression": "happy", "text": "一回合結束！喝口水，休息一下！" },
      { "id": "yiqing-finish-002", "situation": "finish", "affection_min": 0, "expression": "normal", "text": "辛苦了！錯的題目學姊都幫你記下來了，複習的時候見！" },
      { "id": "yiqing-finish-003", "situation": "finish", "affection_min": 0, "expression": "happy", "text": "今天就到這裡！明天也要來喔，說好了！" },
      { "id": "yiqing-finish-004", "situation": "finish", "affection_min": 1, "expression": "happy", "text": "收操！今天也辛苦了，{player}！明天同一時間操場見——啊不對，是讀書會見！" },
      { "id": "yiqing-finish-005", "situation": "finish", "affection_min": 2, "expression": "normal", "text": "跑完一回合了！……那個，你回去的路上要小心喔。到了傳訊息給我。" },
      { "id": "yiqing-finish-006", "situation": "finish", "affection_min": 3, "expression": "shy", "text": "今天就到這裡……好捨不得喔。心跳一直降不下來，這次我不想說是交感神經了。", "rare": true },

      { "id": "yiqing-mock_high-001", "situation": "mock_high", "affection_min": 0, "expression": "surprised", "text": "這個分數！我要繞操場跑三圈慶祝！你也要一起！" },
      { "id": "yiqing-mock_high-002", "situation": "mock_high", "affection_min": 0, "expression": "happy", "text": "看吧！我就說你是一階選手的料！" },

      { "id": "yiqing-msg_review-001", "situation": "msg_review", "affection_min": 0, "expression": "normal", "text": "{player}！今天有 {n} 題錯題到期了，圖書館見！" },
      { "id": "yiqing-msg_review-002", "situation": "msg_review", "affection_min": 0, "expression": "happy", "text": "叮咚～ {n} 題錯題該複習了！趁還記得，衝一波！" },
      { "id": "yiqing-msg_review-003", "situation": "msg_review", "affection_min": 0, "expression": "happy", "text": "今天的訓練菜單：錯題 {n} 題。做完我請你喝運動飲料！" },

      { "id": "yiqing-msg_story-001", "situation": "msg_story", "affection_min": 0, "expression": "shy", "text": "欸欸，今天練完跑……你有空嗎？有件事想跟你說，來找我！" },
      { "id": "yiqing-msg_story-002", "situation": "msg_story", "affection_min": 0, "expression": "shy", "text": "{player}，我在等你喔。來就對了！" },
      { "id": "yiqing-msg_story-003", "situation": "msg_story", "affection_min": 0, "expression": "happy", "text": "今天想跟你多聊一下。來找我吧，我等你！" },

      { "id": "yiqing-msg_streak-001", "situation": "msg_streak", "affection_min": 0, "expression": "happy", "text": "連續 {days} 天了！照這個節奏下去！" },
      { "id": "yiqing-msg_streak-002", "situation": "msg_streak", "affection_min": 0, "expression": "surprised", "text": "{days} 天都沒斷！{player} 你根本是一階選手了吧！" },
      { "id": "yiqing-msg_streak-003", "situation": "msg_streak", "affection_min": 0, "expression": "happy", "text": "連續 {days} 天！今天也辛苦了，記得伸展、早點睡！", "night": true },

      { "id": "yiqing-msg_comeback-001", "situation": "msg_comeback", "affection_min": 0, "expression": "sad", "text": "{player}，最近都沒看到你耶……還好嗎？休息夠了就回來跑吧，我等你！" },
      { "id": "yiqing-msg_comeback-002", "situation": "msg_comeback", "affection_min": 0, "expression": "sad", "text": "好幾天沒一起讀書了！一個人讀好無聊，快回來啦！" },
      { "id": "yiqing-msg_comeback-003", "situation": "msg_comeback", "affection_min": 0, "expression": "normal", "text": "欸，你還好嗎？今天上線寫一題也好！" },

      { "id": "yiqing-gift-001", "situation": "gift", "affection_min": 0, "expression": "happy", "text": "哇！{gift}！給我的嗎？謝謝！" },
      { "id": "yiqing-gift-002", "situation": "gift", "affection_min": 0, "expression": "surprised", "text": "欸欸？突然送東西，我會不好意思耶！好啦謝謝，我會好好珍惜的！", "affection_max": 1 },
      { "id": "yiqing-gift-003", "situation": "gift", "affection_min": 2, "expression": "shy", "text": "每次都送我東西……我也要回禮才行。下一場比賽，我跑第一名給你看！" },
      { "id": "yiqing-gift-004", "situation": "gift", "affection_min": 3, "expression": "shy", "text": "{gift}……謝謝。那個，我現在心跳有點快，不是因為剛跑完步喔。" },
      { "id": "yiqing-gift_liked-001", "situation": "gift_liked", "affection_min": 0, "expression": "happy", "gift": "sports_drink", "text": "運動飲料！你懂我！練完跑就是要喝這個！" },
      { "id": "yiqing-gift_liked-002", "situation": "gift_liked", "affection_min": 0, "expression": "happy", "gift": "wristband", "text": "新護腕！我這條都洗到鬆了……你有在注意我的手腕喔？下一場比賽就戴這條！" },
      { "id": "yiqing-outfit-001", "situation": "outfit", "affection_min": 1, "expression": "happy", "outfit": "yiqing_casual", "text": "新衣服！帽T配短褲，週末晨跑完直接去吃早午餐剛好！欸，{player}，下次要不要一起跑？我配速放慢一點等你！" },
      { "id": "yiqing-outfit-002", "situation": "outfit", "affection_min": 2, "expression": "shy", "outfit": "yiqing_winter", "text": "圍巾和耳罩……你怕我冷喔？冬天在場邊等比賽真的超冷的。……謝謝，好暖。" }
    ]
  }
